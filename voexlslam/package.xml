<?xml version="1.0"?>
<package format="3">
  <name>voexlslam</name>
  <version>0.0.0</version>
  <description>ROS 2 port of Voxel-SLAM.</description>

  <maintainer email="zhengliu1323@hotmail.com">zale</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2_ros</depend>
  <depend>livox_ros_driver2</depend>

  <build_depend>libeigen3-dev</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_depend>libgtsam-dev</build_depend>

  <exec_depend>libpcl-all</exec_depend>
  <exec_depend>libgtsam-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
